	import * as post from '../lib/post';
	import { adapt } from '@sjsf/valibot-validator';
	import { BasicForm, createForm } from '@sjsf/form';

	const form = createForm({
		...defaults,
		...post,
		...adapt(post.schema),
		onSubmit: console.log
	});
</script>

<BasicForm form={form} novalidate />
