  "src/routes/demo/DemoLinks.svelte": "<script lang="ts">
	import { resolve } from '$app/paths';

	const demos = [{ name: 'sjsf', href: resolve('/demo/sjsf') }];
</script>

<!--
	@component
	Lists the add-on demos in \`/demo/<add-on>\`. Added by \`sv add\`.

	To remove: delete \`<DemoLinks />\` and its import, then \`demo/DemoLinks.svelte\`.
-->

<div class="sv-demo-links">
	<p>sv addon demos</p>

	<ul>
		{#each demos as demo (demo.href)}
			<li><a href={demo.href}>{demo.name}</a></li>
		{/each}
	</ul>

	<a class="home" href={resolve('/')}>home</a>
</div>

<style>
	.sv-demo-links {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 9999;
		min-width: 11rem;
		max-width: 16rem;
		padding: 1rem 1.125rem 0.875rem;
		background: linear-gradient(to bottom, #fff9b0, #fff176);
		color: #3d3500;
		font: 14px/1.5 system-ui, sans-serif;
		text-align: left;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.15),
			0 10px 24px -6px rgb(0 0 0 / 0.35);
		transform: rotate(-1.5deg);
	}

	p {
		margin: 0;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	ul {
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		padding: 0.125rem 0;
	}

	a {
		color: #1a4fd6;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	a:visited {
		color: #6b6420;
	}

	a:hover {
		color: #0b2f8a;
	}

	.home {
		display: block;
		margin-top: 0.5rem;
		padding-top: 0.375rem;
		border-top: 1px dashed rgb(61 53 0 / 0.3);
		text-align: right;
		font-size: 12px;
	}

	.home,
	.home:visited {
		color: #6b6420;
	}
</style>
",
  "src/routes/demo/sjsf/+page.server.ts": "import type { Actions } from "@sveltejs/kit";
import type { InitialFormData } from "@sjsf/sveltekit3";
import { createAction } from "@sjsf/sveltekit3/server";
import * as post from "#lib/post/model.generated.js";
import { fromValidators } from "@sjsf/form/validators/precompile";
import { createFormValidatorFactory } from "@sjsf/hyperjump-validator/precompile";
import { validators } from "#lib/post/validators.generated.js";
import * as defaults from "#lib/sjsf/defaults.js";

export const load = async () => {
	return { postForm: post satisfies InitialFormData<post.Model> };
};

export const actions = {
	default: createAction(
		{
			...defaults,
			...post,
			validator: createFormValidatorFactory({ validatorRetriever: fromValidators(validators) }),
			name: "postForm",
			sendData: true
		},
		(data: post.Model) => {
			console.log(data);

			return { post: { ...data, id: "new-post" } };
		}
	)
} satisfies Actions;
",
  "src/routes/demo/sjsf/+page.svelte": "<script lang="ts">
	import * as defaults from '#lib/sjsf/defaults.js';
	import type { ActionData, PageData } from './$types';
	import { createMeta, setupSvelteKitForm } from '@sjsf/sveltekit3/client';
	import { validators } from '#lib/post/validators.generated.js';
	import { createFormValidatorFactory } from '@sjsf/hyperjump-validator/precompile';
	import { fromValidators } from '@sjsf/form/validators/precompile';
	import * as post from '#lib/post/model.generated.js';
	import { BasicForm } from '@sjsf/form';

	const meta = createMeta<ActionData, PageData>().postForm;

	const { form } = setupSvelteKitForm(meta, {
		...defaults,
		validator: createFormValidatorFactory({ validatorRetriever: fromValidators(validators) }),
		onSuccess: (result) => {
			if (result.type === "success") {
				console.log(result.data?.post);
			}
		}
	});
</script>

<BasicForm form={form} method="POST" novalidate />
",
  "src/routes/layout.css": "@import "@sjsf/basic-theme/css/basic.css";
