  "src/routes/demo/sjsf/+page.server.ts": "import type { Actions } from "@sveltejs/kit";
import type { InitialFormData } from "@sjsf/sveltekit3";
import { createAction } from "@sjsf/sveltekit3/server";
import { fromValidators } from "@sjsf/form/validators/precompile";
import { createFormValidatorFactory } from "@sjsf/ajv8-validator/precompile";
import * as validateFunctions from "#lib/post/validators.generated.js";
import * as post from "#lib/post/model.generated.js";
import * as defaults from "#lib/sjsf/defaults.js";

export const load = async () => {
	return { postForm: post satisfies InitialFormData<post.Model> };
};

export const actions = {
	default: createAction(
		{
			...defaults,
			...post,
			validator: createFormValidatorFactory({ validatorRetriever: fromValidators(validateFunctions) }),
			name: "postForm",
			sendData: true
		},
		(data: post.Model) => {
			console.log(data);

			return { post: { ...data, id: "new-post" } };
		}
	)
} satisfies Actions;
",
  "src/routes/demo/sjsf/+page.svelte": "<script lang="ts">
	import * as defaults from '#lib/sjsf/defaults.js';
	import type { ActionData, PageData } from './$types';
	import { createMeta, setupSvelteKitForm } from '@sjsf/sveltekit3/client';
	import * as validateFunctions from '#lib/post/validators.generated.js';
	import { createFormValidatorFactory } from '@sjsf/ajv8-validator/precompile';
	import { fromValidators } from '@sjsf/form/validators/precompile';
	import { BasicForm } from '@sjsf/form';

	const meta = createMeta<ActionData, PageData>().postForm;

	const { form } = setupSvelteKitForm(meta, {
		...defaults,
		validator: createFormValidatorFactory({ validatorRetriever: fromValidators(validateFunctions) }),
		onSuccess: (result) => {
			if (result.type === "success") {
				console.log(result.data?.post);
			}
		}
	});
</script>

<BasicForm form={form} method="POST" novalidate />
