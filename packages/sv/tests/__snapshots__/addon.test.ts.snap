  "src/lib/post.ts": "import type { StandardSchemaV1, StandardJSONSchemaV1 } from "@standard-schema/spec";
import { type Schema, type UiSchemaRoot, ON_INPUT, ON_CHANGE } from "@sjsf/form";
import type { FromSchema } from "json-schema-to-ts";

const internalSchema = {
	"title": "Post",
	"type": "object",
	"properties": {
		"title": { "title": "Title", "type": "string" },
		"content": { "title": "Content", "type": "string", "minLength": 10 }
	},
	"required": ["title", "content"]
} as const satisfies Schema;

type InternalModel = FromSchema<typeof internalSchema>;

// TODO: Replace demo schema with real Standard Schema (arktype, typebox, valibot, zod, etc.)
export const schema: StandardSchemaV1<InternalModel> & StandardJSONSchemaV1 = {
	"~standard": {
		version: 1,
		vendor: "sjsf",
		validate(value) {
			return typeof value === "object" && value !== null
				? { value: value as InternalModel }
				: { issues: [{ message: "Invalid", path: [] }] };
		},

		jsonSchema: {
			input: () => internalSchema,
			output() {
				throw new Error("not implemented");
			}
		}
	}
};

export type Model = StandardSchemaV1.InferInput<typeof schema>;

export const uiSchema = ({
	"content": { "ui:components": { "textWidget": "textareaWidget" } }
} as const satisfies UiSchemaRoot);;

export const initialValue = ({ "title": "New post", "content": "" });;
export const fieldsValidationMode = ON_INPUT | ON_CHANGE;;
