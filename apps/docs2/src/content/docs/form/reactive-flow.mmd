flowchart TD
  subgraph Options["Options (createForm)"]
    schema["schema"]
    uiSchema["uiSchema"]
    uiOptionsRegistry["uiOptionsRegistry"]
    initialValue["initialValue"]
    initialErrors["initialErrors"]
    disabled["disabled"]
    fieldsValidationMode["fieldsValidationMode"]
  end

  subgraph Internal["Internal"]
    validator["validator"]
    merger["merger"]
  end

  subgraph InternalState["Internal State"]
    pathsTrieRef["pathsTrieRef"]
    fieldsStateMap["fieldsStateMap"]
    errors["errors (FormErrors)"]
    valueStore["FORM_VALUE (FormValueStore)"]
  end

  subgraph FormState["FormState"]
    validation["validation"]
    fieldsValidation["fieldsValidation"]
  end

  subgraph Queries["Queries"]
    getValueSnapshot["getValueSnapshot"]
    getFieldErrors["getFieldErrors"]
    hasErrors["hasErrors"]
    getErrors["getErrors"]
    validateFormValue["validateFormValue"]
    getComponent["getComponent"]
    getFieldComponent["getFieldComponent"]
    retrieveSchema["retrieveSchema"]
    isDisabled["isDisabled"]
    hasFieldState["hasFieldState"]
  end

  subgraph Commands["Commands"]
    updateErrors["updateErrors"]
    updateFieldErrors["updateFieldErrors"]
    setValue["setValue"]
    setValueAtPath["setValueAtPath"]
    updateValueAtPath["updateValueAtPath"]
    insertArrayItem["insertArrayItem"]
    removeArrayItem["removeArrayItem"]
    moveArrayItem["moveArrayItem"]
    swapArrayItems["swapArrayItems"]
    validateField["validateField"]
    setFieldState["setFieldState"]
  end

  schema --> validator
  uiSchema --> validator
  uiOptionsRegistry --> validator
  validator --> merger
  schema --> merger
  uiSchema --> merger

  schema --> pathsTrieRef

  merger --> valueStore
  schema --> valueStore
  initialValue --> valueStore

  pathsTrieRef --> fieldsStateMap

  validator --> validation
  validator --> fieldsValidation

  initialErrors --> errors

  valueStore -.-> getValueSnapshot
  errors -.-> getFieldErrors
  errors -.-> hasErrors
  errors -.-> getErrors
  valueStore -.-> validateFormValue
  FormState -.-> getComponent
  FormState -.-> getFieldComponent
  FormState -.-> retrieveSchema
  FormState -.-> isDisabled
  fieldsStateMap -.-> hasFieldState

  errors -.-> updateErrors
  errors -.-> updateFieldErrors
  valueStore -.-> setValue
  valueStore -.-> setValueAtPath
  valueStore -.-> updateValueAtPath
  valueStore -.-> insertArrayItem
  valueStore -.-> removeArrayItem
  valueStore -.-> moveArrayItem
  valueStore -.-> swapArrayItems
  fieldsValidation -.-> validateField
  fieldsStateMap -.-> setFieldState
